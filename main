.include	"tn2313def.inc"

.def	temp = R16
.def	tempH = R17

;.equ

; ------------------ Program Code --------------------------------------------
		.cseg
		.org	0
;--------------------Vectors Interrupt Routines-------------------------

start:	rjmp	reset			; ??????? ?? ?????? ?????????
		reti					; ??????? ?????????? 0
		reti					; ??????? ?????????? 1
		reti					; ??????/??????? 1, ??????
		reti
		;rjmp	t1cmpA			; ??????/??????? 1, ??????????, ????? ?
		reti					; ??????/??????? 1, ?????????? ?? ????????????
		reti					; ??????/??????? 0, ?????????? ?? ????????????
		reti					; ?????????? UART ????? ????????
		reti					; ?????????? UART ??????? ?????? ????
		reti					; ?????????? UART ???????? ?????????
		reti					; ?????????? ?? ???????????
		reti					; ?????????? ?? ????????? ?? ????? ????????
		reti					; ??????/??????? 1, ??????????, ????? B
		reti
		;rjmp	t0cmpA			; ??????/??????? 0, ??????????, ????? A
		reti					; USI ?????????? ? ??????
		reti					; USI ????????????
		reti					; EEPROM ??????????
		reti					; ???????????? ????????? ???????


; ------------- Initialiaztion Module ----------------------------------
reset:
		ldi		temp, RAMEND
		out		SPL, temp

		; ????????????? ????? ??
		; ???????? 14 ? 15
		ldi		temp, (1<<PB3)|(1<<PB2)
		out		PORTB, temp		
		out		DDRB, temp		; ?? ?????

		ldi		temp, 0x80		; ?????????? ???????????
		out		ACSR, temp

		; OCR1A <= 0x04E2 (1250)
		ldi		temp, 0xE2
		ldi		tempH, 0x04
		out		OCR1AH, tempH
		out		OCR1AL, temp

		; T0 8-??? => Fast PWM, Top = 0xFF, Prescaler Off
		ldi		temp, (0<<COM0A1)|(0<<COM0A0)|(0<<COM0B1)|(0<<COM0B0)|(1<<WGM01)|(1<<WGM00)
		out		TCCR0A, temp

		ldi		temp, (0<<WGM02)|(0<<CS02)|(0<<CS01)|(1<<CS00)
		out		TCCR0B, temp

loop:
    inc r16
    rjmp start
